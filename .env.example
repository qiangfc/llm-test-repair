# Copy this file to .env in the directory from which you start the tool.
# Existing process environment variables take precedence over this file.
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=
LLM_MODEL=your-model-name
# Optional exact URL; when set, overrides LLM_BASE_URL.
# LLM_CHAT_ENDPOINT=https://your-provider.example/v1/chat/completions
LLM_TIMEOUT=120
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=12000
LLM_MAX_CALLS=60
LLM_MAX_TOTAL_TOKENS=250000
LLM_RETRIES=2
# Optional provider-specific request options, e.g. disabling thinking.
# DeepSeek Flash example (other providers may use different options):
# LLM_EXTRA_BODY={"thinking":{"type":"disabled"},"response_format":{"type":"json_object"}}
# Local endpoints without authentication: set LLM_ALLOW_NO_KEY=true explicitly.
LLM_ALLOW_NO_KEY=false
